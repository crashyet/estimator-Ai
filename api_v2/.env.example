# Google Gemini API Settings (Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Primary OpenAI-compatible API Settings
PRIMARY_API_BASE=https://openapi.com/v1
PRIMARY_API_KEY=
PRIMARY_MODEL=

# Autodesk APS Cloud Settings (Optional for RVT cloud conversion)
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Server Limits & Timeouts (For large RVT/BIM files)
MAX_UPLOAD_SIZE_MB=500
RVT_TIMEOUT_SECONDS=300

# FastAPI Server Settings & Concurrency
HOST=0.0.0.0
PORT=8200
WORKERS=1
MAX_CONCURRENT_THREADS=100
RELOAD=true
ALLOWED_ORIGINS=*

# AHSP Microservice Settings (Isolated ChromaDB + Embeddings on port 8100)
AHSP_MODE=remote
AHSP_SERVICE_URL=http://127.0.0.1:8100
AHSP_SERVICE_HOST=0.0.0.0
AHSP_SERVICE_PORT=8100

# Reranker Engine Settings ('bge' for local CrossEncoder, 'cohere' for Cohere API)
RERANK_ENGINE=bge

# AHSP Master Dataset File Path
AHSP_EXCEL_PATH=ahsp/Item Pekerjaan CK.xlsx

# Cohere Rerank API Settings (Secondary Fallback)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5