# --------------------------------------------------------------------
# Environment & Sensitive Files
# --------------------------------------------------------------------
.env
*.env
!.env.example

# --------------------------------------------------------------------
# Composer & Node Dependencies
# --------------------------------------------------------------------
/vendor/
/node_modules/
composer.phar
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --------------------------------------------------------------------
# CodeIgniter 4 Writable Directory Exclusions
# Ignore generated cache, logs, sessions, debugbar, uploads
# --------------------------------------------------------------------
/writable/cache/*
!/writable/cache/index.html
!/writable/cache/.gitkeep

/writable/debugbar/*
!/writable/debugbar/index.html
!/writable/debugbar/.gitkeep

/writable/logs/*
!/writable/logs/index.html
!/writable/logs/.gitkeep

/writable/session/*
!/writable/session/index.html
!/writable/session/.gitkeep

/writable/uploads/*
!/writable/uploads/index.html
!/writable/uploads/.gitkeep

# Database backups & SQLite files
*.db
*.sqlite
*.sqlite3
*.sql
*.bak

# --------------------------------------------------------------------
# IDEs & Code Editors Configuration
# --------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PHPStorm / JetBrains
.idea/

# Sublime / Other Editors
*.sublime-project
*.sublime-workspace
*.swp
*~

# --------------------------------------------------------------------
# OS Generated Files
# --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------------------------------------------------------------
# Testing & Code Coverage Reports
# --------------------------------------------------------------------
/build/
.phpunit.result.cache
.php-cs-fixer.cache
.php_cs.cache
/coverage/